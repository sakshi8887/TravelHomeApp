<% layout('layouts/boilerplate') %>
<style>
  #filters{
    display: flex;
    align-items:center;
    overflow-x: auto;   
    gap: 1.5rem;
    padding: 1rem;
    scrollbar-width: none;

  }

  #filters::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 768px) {
  #filters {
    gap: 1rem;
  }

  .filter p {
    font-size: 0.7rem;
  }
}

  .filter{
    flex: 0 0 auto;   
    text-align: center;
    opacity: 0.7;
    display:flex;
    flex-direction: column;
    align-items: center;
  }

  .filter:hover{
    opacity:1;
    cursor: pointer;
  }

  .filter p{
    font-size: 0.8rem;
  }

  .filter i {
    font-size: 1.2rem;
    margin-bottom: 5px;
  }

  #filters a{
    text-decoration:none;
    color:inherit;
  }

  .tax-info{
    display:none;
  }

  .tax-toggle{
    flex: 0 0 auto;   /* ⭐ IMPORTANT */
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 1rem;
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
  .tax-toggle {
    height: auto;
    padding: 0.5rem 1rem;
  }
}
</style>

<div id="filters">
  <a href="/listings" class="filter">
    <i class="fa-solid fa-border-all"></i>
    <p>All</p>
  </a>

  <a href="/listings?category=trending" class="filter">
    <i class="fa-solid fa-fire"></i>
    <p>Trending</p>
  </a>

  <a href="/listings?category=rooms" class="filter">
    <i class="fa-solid fa-bed"></i>
    <p>Rooms</p>
  </a>

  <a href="/listings?category=Iconic cities" class="filter">
    <i class="fa-solid fa-city"></i>
    <p>Iconic cities</p>
  </a>

  <a href="/listings?category=mountains" class="filter">
    <i class="fa-solid fa-mountain"></i>
    <p>Mountains</p>
  </a>

  <a href="/listings?category=Castles" class="filter">
    <i class="fa-solid fa-chess-rook"></i>
    <p>Castles</p>
  </a>

  <a href="/listings?category=Amazing Pools" class="filter">
    <i class="fa-solid fa-water"></i>
    <p>Amazing Pools</p>
  </a>

  <a href="/listings?category=Camping" class="filter">
    <i class="fa-solid fa-campground"></i>
    <p>Camping</p>
  </a>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
  </div>

</div>

<div class="row mt-3">
  <% for(let listing of allListings){ %>

    <div class="col-md-3 mb-3">
      <a href="/listings/<%= listing._id %>" class="listing-link">

        <div class="card h-100 listing-card">
          <img 
            src="<%= typeof listing.image === 'string' ? listing.image : listing.image.url %>"  
            class="card-img-top" 
            alt="listing_image" 
            style="height: 20rem; object-fit: cover;"
          />
          
          <div class="card-img-overlay"></div>

          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br>
              &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
              <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
            </p>
          </div>
        </div>

      </a>
    </div>

  <% } %>
</div>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", ()=>{
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo){
      if(info.style.display != "inline"){
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>