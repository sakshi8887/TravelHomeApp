<% layout('layouts/boilerplate') %>

<div class="row mt-3">
    <div class="col-8 offset-2">
    <br><br>
    <h3>Create New Listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation"  enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Title:</label>
            <input type="text" id="listing[title]" placeholder="Add a catchy title" name="listing[title]"  required class="form-control">
            <div class="valid-feedback">
                Title looks good!
            </div>
        </div>
        
        <div class="mb-3">
            <label for="description" class="form-label">Description:</label>
            <textarea id="listing[description]" placeholder="enter description" name="listing[description]"  required class="form-control"></textarea>
            <div class="invalid-feedback">
                Please enter a valid description.
            </div>
        </div>

        <div class="mb-3">
            <label for="image" class="form-label">Upload Listing Image:</label>
            <input type="file" id="listing[image]"  name="listing[image][url]"  required class="form-control">
            
        </div>
        
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price:</label>
            <input  id="listing[price]" placeholder="1200" name="listing[price]"  required class="form-control">
            <div class="invalid-feedback">
                Price should be valid.
            </div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="location" class="form-label">Location:</label>
            <input type="text" id="listing[location]" placeholder="Jaipur, Rajasthan" name="listing[location]"  required class="form-control">
            <div class="invalid-feedback">
                Location name should be valid.
            </div>
          </div>
        </div>
        
 
        <div class="mb-3">
            <label for="country" class="form-label">Country:</label>
            <input type="text" id="listing[country]" placeholder="India" name="listing[country]"  required class="form-control">
            <div class="invalid-feedback">
                Country name should be valid.
            </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Category:</label>
          <select name="listing[category]" class="form-control" required>
              <option value="Iconic cities">Iconic cities</option>
              <option value="trending">Trending</option>
              <option value="rooms">Rooms</option>
              <option value="mountains">Mountains</option>
              <option value="Castles">Castles</option>
              <option value="Amazing Pools">Amazing Pools</option>
              <option value="Camping">Camping</option>
           </select>
       <div class="invalid-feedback">
          Please select a category.
       </div>
    </div>

        
       <button class="btn btn-dark add-btn mt-3">Add</button>
       
    </form>
    </div>
</div>
